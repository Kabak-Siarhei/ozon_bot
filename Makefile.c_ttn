# Makefile для ttn_add_field (MuPDF / mupdf-c)
#
# Требует установленные заголовочные файлы и библиотеку MuPDF.
# Нет зависимостей от Python.
#
# Переменные можно задать при вызове make:
#   make MUPDF_INC=/usr/local/include MUPDF_LIB=/usr/local/lib

CC      ?= cc
CFLAGS  ?= -std=c11 -Wall -Wextra -O2
LDFLAGS ?= -lmupdf -lm -lz

TARGET  = ttn_add_field
SRCS    = ttn_add_field.c ttn_config.c

MUPDF_INC ?= /usr/local/include
MUPDF_LIB ?= /usr/local/lib

.PHONY: all clean run test

all: $(TARGET)

$(TARGET): $(SRCS) ttn_config.h
	$(CC) $(CFLAGS) -I"$(MUPDF_INC)" -o $@ $(SRCS) -L"$(MUPDF_LIB)" $(LDFLAGS)

clean:
	rm -f $(TARGET) *.pdf *.o

run: $(TARGET)
	LD_LIBRARY_PATH="$(MUPDF_LIB)" ./$(TARGET) \
	    ../ozon_bot/tests/fixtures/ttn.pdf ttn_output.pdf -c settings.example.ini

test: $(TARGET)
	@echo "=== Тест 1: 5 полей по умолчанию (без ini) ==="
	@LD_LIBRARY_PATH="$(MUPDF_LIB)" ./$(TARGET) \
	    ../ozon_bot/tests/fixtures/ttn.pdf ttn_test_default.pdf
	@echo ""
	@echo "=== Тест 2: 5 полей из ini-файла ==="
	@LD_LIBRARY_PATH="$(MUPDF_LIB)" ./$(TARGET) \
	    ../ozon_bot/tests/fixtures/ttn.pdf ttn_test_ini.pdf -c settings.example.ini
	@echo ""
	@echo "=== Тест 3: одно кастомное поле ==="
	@LD_LIBRARY_PATH="$(MUPDF_LIB)" ./$(TARGET) \
	    ../ozon_bot/tests/fixtures/ttn.pdf ttn_test_single.pdf \
	    100 200 300 210 "Автомобиль" "BMW X5 A123BC"
	@echo ""
	@echo "=== Тест 4: ошибка — несуществующий файл ==="
	@LD_LIBRARY_PATH="$(MUPDF_LIB)" ./$(TARGET) /nonexistent.pdf out.pdf || true
